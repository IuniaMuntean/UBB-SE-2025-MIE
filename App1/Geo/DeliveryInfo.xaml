<Window
    x:Class="App1.Geo.DeliveryInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1.Geo"
    xmlns:model="using:App1.Geo.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Delivery Info"
    Width="800" Height="600">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding StatusDisplay}" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="20">
                <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Route Information" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="{Binding RouteDisplay}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Staff Information" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="{Binding StaffDisplay}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Schedule" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="{Binding TimeDisplay}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Cargo Information" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="{Binding CargoDisplay}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="15" VerticalAlignment="Top">
                <Button Content="Generate Route" 
                        Click="GenerateRoute_Click" 
                        Margin="0,0,0,10"
                        Background="#0078D4"
                        Foreground="White"/>
                <Button Content="Calculate Pricing" 
                        Click="CalculatePricing_Click" 
                        Margin="0,0,0,10"
                        Background="#0078D4"
                        Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
