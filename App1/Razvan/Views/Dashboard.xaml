<Page
    x:Class="App1.AuthFeature.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1.AuthFeature.Views">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="Welcome to the Dashboard!" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="You have successfully logged in." />
        <Button Content="Log out" Click="OnLogoutClicked" />
        <Button Content="Profit Calculator" x:Name="btnProfitCalc" Click="btnProfitCalc_Click"/>
        <Button x:Name="btnGraphView" Content="Graph View" Click="btnGraphView_Click" />
        <Button x:Name="btnGeo" Content="Geo" Click="btnGeo_Click" />
        <Button x:Name="btnToma" Content="Toma" Click="btnToma_CLick"/>
        <Button x:Name="btnVlad" Content="Vlad" Click="btnVlad_Click"/>
    </StackPanel>
</Page>
