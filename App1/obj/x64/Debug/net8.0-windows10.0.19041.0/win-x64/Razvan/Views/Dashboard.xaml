<Page
    x:Class="App1.AuthFeature.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1.AuthFeature.Views">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="Welcome to the Dashboard!" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="You have successfully logged in." />
        <Button x:ConnectionId='2' Content="Log out"                         />
        <Button x:ConnectionId='3' Content="Profit Calculator" x:Name="btnProfitCalc"                            />
        <Button x:ConnectionId='4' x:Name="btnGraphView" Content="Graph View"                            />
        <Button x:ConnectionId='5' x:Name="btnGeo" Content="Geo"                      />
        <Button x:ConnectionId='6' x:Name="btnToma" Content="Toma"                      />
        <Button x:ConnectionId='7' x:Name="btnVlad" Content="Vlad"                      />
    </StackPanel>
</Page>

