<Page
    x:Class="App1.AuthFeature.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:App1.AuthFeature.ViewModels">

	<Page.DataContext>
		<vm:LoginViewModel/>
	</Page.DataContext>

	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
		<TextBlock Text="Login" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
		<TextBox PlaceholderText="Username" Text="{Binding Username, Mode=TwoWay}" Width="250"/>
		<PasswordBox x:ConnectionId='2' x:Name="passwordBox" Width="250"/>
		<Button x:ConnectionId='3' Content="Login" Width="250"                       />
		<Button x:ConnectionId='4' Content="Create an account" Width="250"                           />
	</StackPanel>
</Page>

